{
  "name": "@local/claude-signin",
  "version": "1.0.0",
  "private": true,
  "description": "Sign in to Claude (Claude Pro/Max) from the Anthropic provider card in Models settings.",
  "type": "module",
  "main": "./host.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
